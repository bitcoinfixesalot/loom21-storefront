# Loom21 storefront settings. Copy to .env (npm run serve and docker compose read it). Never commit .env.

# single = one store from LOOM21_PUBLISHABLE_KEY (self-hosted). hosted = loom21's own multi-store deployment (deploy/hosted/README.md).
STOREFRONT_MODE=single

# The Storefront API.
LOOM21_API_BASE=https://app.loom21.com/storefront/v1

# Settings → Storefronts → your storefront → Developer.
LOOM21_PUBLISHABLE_KEY=l21_pk_live_...
# Optional but strongly recommended: Developer → Server secret → Generate. Server only: it is never sent to browsers.
# With it, the API's per-IP limits count each shopper instead of this server.
LOOM21_SERVER_SECRET=l21_ss_...

# The store's own address: canonical URLs, sitemap.xml. Add it to the storefront's Allowed websites too.
PUBLIC_BASE_URL=https://shop.example.com

# How long catalog pages are cached in memory, per store (0 = off).
HTML_CACHE_SECONDS=30
# Behind proxies, so the shopper's IP comes from X-Forwarded-For: true behind one proxy you control (Caddy),
# or the number of proxies in front (2 behind Cloudflare and Azure's ingress).
TRUST_PROXY=true
PORT=4000

# Hosted mode only (loom21's deployment): the platform's host secret and loom21's internal port.
# LOOM21_HOST_SECRET=
# LOOM21_INTERNAL_API_BASE=http://loom21-api:8081
